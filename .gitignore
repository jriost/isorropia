# datos intermedios del auto-etiquetado (se regeneran con auto_label.py + prepare_split.py)
ml/dataset/labeled/
ml/dataset/split/
ml/dataset/debug_preview/

# dataset_tool: descargas temporales de video
dataset_tool/_tmp_videos/
dataset_tool/__pycache__/

# generado, no fuente
PLAN.html

